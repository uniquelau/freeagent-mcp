# Copy this file to `.env` and fill in your values. `.env` is gitignored —
# never commit real credentials. After setting CLIENT_ID/SECRET, authenticate
# once with: `npx freeagent-mcp-server auth`

# FreeAgent OAuth2 credentials (from the Developer Dashboard)
FREEAGENT_CLIENT_ID=your_client_id_here
FREEAGENT_CLIENT_SECRET=your_client_secret_here

# Set to "true" to use the FreeAgent sandbox instead of production.
# Strongly recommended while testing.
# FREEAGENT_SANDBOX=true

# Override the API base URL (must be HTTPS, or localhost). Rarely needed.
# FREEAGENT_BASE_URL=https://api.freeagent.com/v2

# Legacy: provide a token directly (skips the stored OAuth flow)
# FREEAGENT_ACCESS_TOKEN=your_access_token_here

# ── Tool gating (security) ───────────────────────────────────────────────
# By default the server is LOCKED DOWN: only read tools (list_*/get_*) and
# freeagent_reconcile_bank_transaction are registered. Configure as needed:
#
# Enable every write/delete tool (legacy behaviour):
# FREEAGENT_ENABLE_WRITES=true
#
# Strict allowlist — register ONLY these tools (overrides the default set):
# FREEAGENT_ENABLED_TOOLS=freeagent_list_bank_transactions,freeagent_get_bank_transaction,freeagent_reconcile_bank_transaction,freeagent_get_profit_and_loss
#
# Blocklist — never register these (always wins, even over an allowlist):
# FREEAGENT_DISABLED_TOOLS=freeagent_delete_bank_account,freeagent_delete_invoice
